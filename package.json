{
  "name": "game-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "games/*",
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node services/backend/server.mjs",
    "start": "node services/backend/server.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "check": "tsc --noEmit && node tests/contracts.mjs && node tests/client.mjs && node tests/server.mjs && node tests/migration.mjs && npm run check -w @game-lab/orbital-drift",
    "check:browser": "node tests/browser.mjs",
    "check:release": "node tests/release.mjs",
    "new:game": "node scripts/new-game.mjs",
    "format": "oxfmt packages services/backend scripts tests tooling games/orbital-drift/app games/orbital-drift/lib games/orbital-drift/components games/orbital-drift/scripts games/signal-tap/web apps/portal/public",
    "link": "node scripts/campaign-link.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "oxfmt": "0.72.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
